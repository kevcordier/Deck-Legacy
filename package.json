{
  "name": "deck-legacy",
  "private": true,
  "version": "v1.0.0-beta.3",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "pnpm --filter @deck-legacy/client dev",
    "dev:server": "pnpm --filter @deck-legacy/server dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @deck-legacy/server prisma:migrate",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build:client": "pnpm --filter @deck-legacy/client build",
    "build:server": "pnpm --filter @deck-legacy/server... build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "verify": "pnpm format && pnpm lint:fix && pnpm typecheck && pnpm depcruise && pnpm test:coverage"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.1",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md,json,yaml}": [
      "prettier --write"
    ]
  }
}
