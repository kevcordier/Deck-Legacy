{
  "name": "deck-legacy",
  "private": true,
  "version": "v1.0.0-beta.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src tests stories --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src tests stories --ext ts,tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests stories",
    "format:check": "prettier --check src tests stories",
    "preview": "vite preview",
    "test": "vitest run",
    "prepare": "husky",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "pnpm format && pnpm lint:fix && pnpm typecheck && pnpm depcruise && pnpm test:coverage"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react-modal": "^3.16.3",
    "i18next": "^26.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.2",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-joyride": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-modal": "^3.16.3",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.8.4",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-themes": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "dependency-cruiser": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-storybook": "10.3.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^10.4.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm lint:fix",
      "pnpm format"
    ],
    "*.{css,scss,md,json,yaml}": [
      "pnpm format"
    ]
  }
}
