{
  "name": "@deck-legacy/api-contract",
  "private": true,
  "version": "1.0.0",
  "description": "HTTP contract (zod schemas and DTO types) shared by the Deck-Legacy server and client.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
