{
  "name": "@deck-legacy/engine",
  "private": true,
  "version": "1.0.0",
  "description": "Deck-Legacy game engine: game rules (domain) and the game session (application).",
  "exports": {
    "./domain/types": {
      "source": "./src/domain/types/index.ts",
      "types": "./dist/domain/types/index.d.ts",
      "default": "./dist/domain/types/index.js"
    },
    "./domain/enums": {
      "source": "./src/domain/enums/index.ts",
      "types": "./dist/domain/enums/index.d.ts",
      "default": "./dist/domain/enums/index.js"
    },
    "./domain/cardAction": {
      "source": "./src/domain/cardAction/index.ts",
      "types": "./dist/domain/cardAction/index.d.ts",
      "default": "./dist/domain/cardAction/index.js"
    },
    "./domain/gameEvent": {
      "source": "./src/domain/gameEvent/index.ts",
      "types": "./dist/domain/gameEvent/index.d.ts",
      "default": "./dist/domain/gameEvent/index.js"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}
