{
  "//": "Path aliases of every workspace, used by dependency-cruiser to resolve imports.",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@domain/*": ["./apps/client/src/domain/*"],
      "@application/*": ["./apps/client/src/application/*"],
      "@infrastructure/*": ["./apps/client/src/infrastructure/*"],
      "@composition/*": ["./apps/client/src/composition/*"],
      "@components/*": ["./apps/client/src/presentation/components/*"],
      "@contexts/*": ["./apps/client/src/presentation/contexts/*"],
      "@hooks/*": ["./apps/client/src/presentation/hooks/*"],
      "@pages/*": ["./apps/client/src/presentation/pages/*"],
      "@styles/*": ["./apps/client/src/presentation/styles/*"],
      "@i18n/*": ["./apps/client/src/presentation/i18n/*"],
      "@data/*": ["./apps/client/src/data/*"],
      "@services/*": ["./apps/client/src/services/*"],
      "@assets/*": ["./apps/client/assets/*"],
      "@engine/*": ["./packages/engine/src/*"],
      "@presentation/*": ["./apps/client/src/presentation/*"]
    }
  },
  "include": ["apps/*/src/**/*", "packages/*/src/**/*"]
}
