# Copy to .env and adjust.
PORT=3000
NODE_ENV=development

# PostgreSQL (see docker-compose.yml at the repository root)
DATABASE_URL=postgresql://deck:deck@localhost:5432/deck_legacy

# Supabase Auth: project URL, used to verify access tokens with the project JWKS.
SUPABASE_URL=https://your-project.supabase.co
# Optional: secret (service role) key, only used to delete accounts. Without it, DELETE /me
# answers 503. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed browser origins (Expo web dev server, GitHub Pages…)
CORS_ORIGINS=http://localhost:8081,https://kevcordier.github.io

# Accept synced games that used the development cheat panel (forced off in production)
ALLOW_CHEATS=false
