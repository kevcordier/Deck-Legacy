  "info": {
    "title": "Deck-Legacy API",
    "description": "Accounts, game sync (event logs replayed for validation), scores.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION",
              "INVALID_GAME",
              "NOT_FOUND",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "SERVER_ERROR",
              "KINGDOM_LIMIT",
              "STALE_VERSION"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "isAnonymous": {
            "type": "boolean"
          },
          "email": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "displayName",
          "isAnonymous",
          "email"
        ]
      },
      "UpdateProfileRequestDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32
          }
        },
        "required": [
          "displayName"
        ]
      },
      "LeaderboardDto": {
        "type": "object",
        "properties": {
          "segment": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "gameId": {
                  "type": "string"
                },
                "segment": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "createdAt": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "id",
                "gameId",
                "segment",
                "score",
                "createdAt",
                "displayName"
              ]
            }
          }
        },
        "required": [
          "segment",
          "entries"
        ]
      },
      "KingdomRankingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "score": {
            "type": "number"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "segment": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                }
              },
              "required": [
                "segment",
                "score"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "displayName",
          "score",
          "segments"
        ]
      },
      "ScoreEntryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "gameId": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "gameId",
          "segment",
          "score",
          "createdAt",
          "displayName"
        ]
      },
      "GameSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "eventCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "score": {
            "type": "number"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "segment": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                }
              },
              "required": [
                "segment",
                "score"
              ]
            }
          },
          "finished": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "eventCount",
          "score",
          "segments",
          "finished",
          "updatedAt"
        ]
      },
      "SyncGameRequestDto": {
        "type": "object",
        "properties": {
          "events": {
            "maxItems": 20000,
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "fromSeq": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "baseVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "cardNames": {
            "default": {},
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 60
            }
          },
          "name": {
            "default": "",
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "events"
        ]
      },
      "GameExportDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "cardNames": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "savedAt": {
            "type": "number"
          },
          "checkpoint": {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "state": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "seq",
              "state"
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "events",
          "cardNames",
          "savedAt"
        ]
      }
    }
  }
}
