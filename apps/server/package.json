{
  "name": "@deck-legacy/server",
  "private": true,
  "version": "1.0.0",
  "description": "Deck-Legacy API: accounts, game sync (event logs replayed for validation), scores and leaderboard.",
  "scripts": {
    "build": "pnpm prisma:generate && nest build -p tsconfig.build.json",
    "dev": "pnpm --filter \"@deck-legacy/server^...\" build && pnpm prisma:generate && nest start --watch -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "test": "pnpm prisma:generate && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm prisma:generate && vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "generate:openapi": "pnpm prisma:generate && vitest run tests/games.e2e.test.ts -u"
  },
  "dependencies": {
    "@deck-legacy/engine": "workspace:*",
    "@deck-legacy/game-data": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "jose": "^6.2.13",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0"
  }
}
