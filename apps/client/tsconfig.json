{
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "customConditions": ["react-native", "source"],
    "types": ["node"],
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@application/*": ["./src/application/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@composition/*": ["./src/composition/*"],
      "@components/*": ["./src/presentation/components/*"],
      "@contexts/*": ["./src/presentation/contexts/*"],
      "@hooks/*": ["./src/presentation/hooks/*"],
      "@pages/*": ["./src/presentation/pages/*"],
      "@styles/*": ["./src/presentation/styles/*"],
      "@i18n/*": ["./src/presentation/i18n/*"],
      "@data/*": ["./src/data/*"],
      "@services/*": ["./src/services/*"],
      "@assets/*": ["./assets/*"],
      "@presentation/*": ["./src/presentation/*"]
    }
  },
  "include": [
    "index.ts",
    "nativewind-env.d.ts",
    "src/**/*",
    "tests/**/*",
    "stories/**/*",
    ".rnstorybook/**/*",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "android", "ios"]
}
