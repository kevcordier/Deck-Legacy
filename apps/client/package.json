{
  "name": "@deck-legacy/client",
  "private": true,
  "version": "1.0.0-beta.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "pnpm generate:illustrations && expo export --platform web && node scripts/spa-fallback.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --android",
    "storybook:web": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --web",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "generate:illustrations": "node scripts/generate-illustrations.mjs",
    "generate:api": "openapi-typescript ../server/openapi.json --default-non-nullable false -o src/infrastructure/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@deck-legacy/engine": "workspace:*",
    "@deck-legacy/game-data": "workspace:*",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/cinzel-decorative": "^0.4.1",
    "@expo-google-fonts/eb-garamond": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.5.11",
    "nativewind": "4.2.7",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.0",
    "react-native-marked": "^8.3.2",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-dnd": "2.0.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@storybook/addon-ondevice-actions": "^10.7.0",
    "@storybook/addon-ondevice-controls": "^10.7.0",
    "@storybook/react-native": "^10.7.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "openapi-typescript": "^7.13.0",
    "react-native-gesture-handler": "~3.3.0",
    "storybook": "^10.6.4",
    "tailwindcss": "^3.4.19"
  }
}
