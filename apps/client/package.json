{
  "name": "@deck-legacy/client",
  "private": true,
  "version": "1.0.0-beta.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "pnpm generate:illustrations && expo export --platform web && node scripts/spa-fallback.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --android",
    "storybook:web": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --web",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "generate:illustrations": "node scripts/generate-illustrations.mjs"
  },
  "dependencies": {
    "@deck-legacy/api-contract": "workspace:*",
    "@deck-legacy/engine": "workspace:*",
    "@deck-legacy/game-data": "workspace:*",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/cinzel-decorative": "^0.4.1",
    "@expo-google-fonts/eb-garamond": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-marked": "^8.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-dnd": "2.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@storybook/addon-ondevice-actions": "^10.6.0",
    "@storybook/addon-ondevice-controls": "^10.6.0",
    "@storybook/react-native": "^10.6.0",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "react-native-gesture-handler": "~2.32.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^3.4.19"
  }
